{
  "name": "promptguard-vscode",
  "displayName": "PromptGuard",
  "description": "Plug-and-play LLM security for your AI applications",
  "version": "0.6.0",
  "publisher": "promptguard",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other",
    "Linters"
  ],
  "keywords": [
    "llm",
    "cybersecurity",
    "firewall",
    "jailbreak",
    "pii-detection",
    "data-leakage",
    "data-exfiltration",
    "dlp",
    "security",
    "openai",
    "anthropic",
    "cohere",
    "aws-bedrock",
    "gemini",
    "prompt-injection",
    "ai-security"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "PromptGuard executes a CLI binary and scans workspace files; it is disabled in untrusted workspaces."
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "promptguard",
          "title": "PromptGuard",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "promptguard": [
        {
          "id": "promptguard.managedFiles",
          "name": "PromptGuard",
          "icon": "$(shield)",
          "contextualTitle": "PromptGuard"
        }
      ]
    },
    "commands": [
      {
        "command": "promptguard.init",
        "title": "PromptGuard: Initialize",
        "category": "PromptGuard"
      },
      {
        "command": "promptguard.scan",
        "title": "PromptGuard: Scan for LLM SDKs",
        "category": "PromptGuard"
      },
      {
        "command": "promptguard.status",
        "title": "PromptGuard: Show Status",
        "category": "PromptGuard"
      },
      {
        "command": "promptguard.apply",
        "title": "PromptGuard: Apply Transformations",
        "category": "PromptGuard"
      },
      {
        "command": "promptguard.disable",
        "title": "PromptGuard: Disable",
        "category": "PromptGuard"
      },
      {
        "command": "promptguard.enable",
        "title": "PromptGuard: Enable",
        "category": "PromptGuard"
      },
      {
        "command": "promptguard.scanSelection",
        "title": "PromptGuard: Scan Selection for Threats",
        "category": "PromptGuard"
      },
      {
        "command": "promptguard.redactSelection",
        "title": "PromptGuard: Redact PII from Selection",
        "category": "PromptGuard"
      },
      {
        "command": "promptguard.scanFile",
        "title": "PromptGuard: Scan File for Threats",
        "category": "PromptGuard"
      },
      {
        "command": "promptguard.setApiKey",
        "title": "PromptGuard: Set API Key",
        "category": "PromptGuard"
      },
      {
        "command": "promptguard.selectProject",
        "title": "PromptGuard: Select Project",
        "category": "PromptGuard"
      },
      {
        "command": "promptguard.refreshUI",
        "title": "PromptGuard: Refresh",
        "category": "PromptGuard",
        "icon": "$(refresh)"
      },
      {
        "command": "promptguard.installCli",
        "title": "PromptGuard: Install/Update CLI",
        "category": "PromptGuard"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "promptguard.refreshUI",
          "when": "view == promptguard.managedFiles",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "promptguard.scanSelection",
          "when": "editorHasSelection",
          "group": "promptguard@1"
        },
        {
          "command": "promptguard.redactSelection",
          "when": "editorHasSelection",
          "group": "promptguard@2"
        }
      ],
      "explorer/context": [
        {
          "command": "promptguard.scanFile",
          "when": "resourceLangId == typescript || resourceLangId == typescriptreact || resourceLangId == javascript || resourceLangId == javascriptreact || resourceLangId == python",
          "group": "promptguard@1"
        }
      ]
    },
    "configuration": {
      "title": "PromptGuard",
      "properties": {
        "promptguard.cliPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Path to the PromptGuard CLI binary. Leave empty to auto-detect from PATH. Machine-scoped: cannot be overridden by workspace settings (a cloned repo must not be able to point this at an arbitrary executable)."
        },
        "promptguard.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-scan the workspace for LLM SDK usage when a supported file is saved. Disable if scanning is slow on large workspaces."
        },
        "promptguard.autoInstallCli": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "prompt",
            "never",
            "auto"
          ],
          "enumDescriptions": [
            "Ask before installing the CLI when it is not found (default).",
            "Never offer to install the CLI; configure the path manually.",
            "Install the CLI silently when it is not found."
          ],
          "default": "prompt",
          "description": "Behavior when the PromptGuard CLI is not found on first run: prompt (ask), never (do nothing), or auto (install silently)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.5",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "3.9.2",
    "eslint": "^9.39.5",
    "glob": "^13.0.6",
    "mocha": "^11.7.6",
    "prettier": "^3.9.5",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.63.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3",
    "js-yaml": "^4.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acebot712/promptguard-vscode"
  },
  "license": "Apache-2.0"
}
